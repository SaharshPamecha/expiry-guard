#!/usr/bin/env bash
#
# expiry-guard — Temporary User Lifecycle Manager
# A lightweight, production-grade CLI for creating and auditing temporary Linux user accounts
#
# Author: Saharsh Pamecha
# License: MIT
#

set -euo pipefail

readonly VERSION="1.0.0"
readonly SCRIPT_NAME="expiry-guard"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
ORANGE='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

# Logging functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[✓]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[✗]${NC} $1"; }

# Show usage information
show_usage() {
    cat << EOF
${BOLD}expiry-guard${NC} — Temporary User Lifecycle Manager v${VERSION}

${BOLD}USAGE:${NC}
    expiry-guard <command> [options]

${BOLD}COMMANDS:${NC}
    create <username> <YYYY-MM-DD>  Create temporary user with expiry date
    audit [--days=N]                 List all expiring/temporary users
    report [--format=html|json]      Generate compliance report
    alert [--days=7]                 Show accounts expiring soon (default: 7 days)
    help                             Show this help message
    version                          Show version information

${BOLD}EXAMPLES:${NC}
    # Create a contractor account expiring end of contract
    sudo expiry-guard create contractor-a 2025-12-31

    # Audit all temporary accounts
    sudo expiry-guard audit

    # Show accounts expiring in next 14 days
    sudo expiry-guard alert --days=14

    # Generate HTML compliance report
    sudo expiry-guard report --format=html

${BOLD}NOTES:${NC}
    • Requires root privileges for user creation
    • Expiry dates are stored in /etc/shadow (requires sudo to read)
    • Compatible with all Linux distributions using shadow-utils

EOF
}

# Check if running as root
check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This command requires root privileges. Use sudo."
        exit 1
    fi
}

# Validate date format (YYYY-MM-DD)
validate_date() {
    local date_str="$1"
    if ! [[ $date_str =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        log_error "Invalid date format. Use YYYY-MM-DD (e.g., 2025-12-31)"
        exit 1
    fi
    
    # Check if date is valid
    if ! date -d "$date_str" &>/dev/null; then
        log_error "Invalid date: $date_str"
        exit 1
    fi
    
    # Check if date is in the future
    local expiry_ts=$(date -d "$date_str" +%s)
    local today_ts=$(date +%s)
    
    if [[ $expiry_ts -lt $today_ts ]]; then
        log_warn "Expiry date is in the past: $date_str"
    fi
}

# Calculate days until expiry
days_until_expiry() {
    local expiry_date="$1"
    local expiry_ts=$(date -d "$expiry_date" +%s 2>/dev/null || echo 0)
    local today_ts=$(date +%s)
    local days=$(( (expiry_ts - today_ts) / 86400 ))
    echo "$days"
}

# Get expiry date for a user
get_user_expiry() {
    local username="$1"
    local expiry_info=$(chage -l "$username" 2>/dev/null | grep "Account expires" || echo "Account expires: never")
    echo "$expiry_info" | awk -F': ' '{print $2}' | xargs
}

# Create temporary user with expiry
cmd_create() {
    local username="$1"
    local expiry_date="$2"
    
    check_root
    
    # Validate inputs
    if [[ -z "$username" ]] || [[ -z "$expiry_date" ]]; then
        log_error "Usage: expiry-guard create <username> <YYYY-MM-DD>"
        exit 1
    fi
    
    validate_date "$expiry_date"
    
    # Check if user already exists
    if id "$username" &>/dev/null; then
        log_error "User '$username' already exists"
        exit 1
    fi
    
    log_info "Creating temporary user: $username"
    log_info "Expiry date: $expiry_date"
    
    # Create user with expiry
    useradd -e "$expiry_date" -m -s /bin/bash "$username"
    
    log_success "Temporary user '$username' created successfully"
    
    # Display verification
    echo ""
    log_info "Verification:"
    chage -l "$username" | grep -E "(Account expires|Last password change)"
    
    # Calculate days remaining
    local days=$(days_until_expiry "$expiry_date")
    if [[ $days -gt 0 ]]; then
        log_info "Account will expire in $days days"
    fi
}

# Audit all temporary/expiring users
cmd_audit() {
    local days_filter=""
    
    # Parse optional --days filter
    for arg in "$@"; do
        if [[ $arg =~ ^--days=([0-9]+)$ ]]; then
            days_filter="${BASH_REMATCH[1]}"
        fi
    done
    
    check_root
    
    log_info "Auditing user accounts..."
    echo ""
    
    # Header
    printf "${BOLD}%-20s %-18s %12s %10s${NC}\n" "USERNAME" "EXPIRES" "DAYS LEFT" "STATUS"
    printf "%-20s %-18s %12s %10s\n" "--------------------" "------------------" "------------" "----------"
    
    local found_count=0
    
    # Get all users (UID >= 1000, excluding system users)
    while IFS=: read -r username _ uid _ _ _ shell; do
        if [[ $uid -ge 1000 ]]; then
            local expiry=$(get_user_expiry "$username")
            
            if [[ "$expiry" != "never" ]] && [[ -n "$expiry" ]]; then
                local days=$(days_until_expiry "$expiry")
                local status="${GREEN}active${NC}"
                
                if [[ $days -lt 0 ]]; then
                    status="${RED}EXPIRED${NC}"
                elif [[ $days -le 7 ]]; then
                    status="${YELLOW}urgent${NC}"
                fi
                
                # Apply days filter if specified
                if [[ -n "$days_filter" ]]; then
                    if [[ $days -gt $days_filter ]]; then
                        continue
                    fi
                fi
                
                printf "%-20s %-18s %12s %b\n" "$username" "$expiry" "$days" "$status"
                ((found_count++))
            fi
        fi
    done < /etc/passwd
    
    echo ""
    if [[ $found_count -eq 0 ]]; then
        log_warn "No temporary/expiring users found"
    else
        log_success "Found $found_count temporary account(s)"
    fi
}

# Show alerts for expiring accounts
cmd_alert() {
    local alert_days=7
    
    # Parse optional --days parameter
    for arg in "$@"; do
        if [[ $arg =~ ^--days=([0-9]+)$ ]]; then
            alert_days="${BASH_REMATCH[1]}"
        fi
    done
    
    check_root
    
    log_info "Checking for accounts expiring within $alert_days days..."
    echo ""
    
    local urgent_count=0
    local expired_count=0
    
    printf "${BOLD}%-20s %-18s %12s %12s${NC}\n" "USERNAME" "EXPIRES" "DAYS LEFT" "ACTION"
    printf "%-20s %-18s %12s %12s\n" "--------------------" "------------------" "------------" "------------"
    
    while IFS=: read -r username _ uid _ _ _ shell; do
        if [[ $uid -ge 1000 ]]; then
            local expiry=$(get_user_expiry "$username")
            
            if [[ "$expiry" != "never" ]] && [[ -n "$expiry" ]]; then
                local days=$(days_until_expiry "$expiry")
                
                if [[ $days -lt 0 ]]; then
                    printf "%-20s %-18s %12s ${RED}%s${NC}\n" "$username" "$expiry" "$days" "DELETE NOW"
                    ((expired_count++))
                elif [[ $days -le $alert_days ]]; then
                    printf "%-20s %-18s %12s ${YELLOW}%s${NC}\n" "$username" "$expiry" "$days" "REVIEW"
                    ((urgent_count++))
                fi
            fi
        fi
    done < /etc/passwd
    
    echo ""
    
    if [[ $expired_count -gt 0 ]] || [[ $urgent_count -gt 0 ]]; then
        log_warn "Found $expired_count expired and $urgent_count urgent account(s)"
        echo ""
        echo "Recommended actions:"
        if [[ $expired_count -gt 0 ]]; then
            echo "  • Run: expiry-guard cleanup (to remove expired accounts)"
        fi
        echo "  • Review urgent accounts and extend or revoke access"
        echo "  • Update documentation for temporary access procedures"
    else
        log_success "No urgent or expired accounts found"
    fi
}

# Generate compliance report
cmd_report() {
    local format="table"
    local output_file=""
    
    # Parse arguments
    for arg in "$@"; do
        case $arg in
            --format=html) format="html" ;;
            --format=json) format="json" ;;
            --format=csv) format="csv" ;;
            --output=*) output_file="${arg#*=}" ;;
        esac
    done
    
    check_root
    
    local report_date=$(date '+%Y-%m-%d %H:%M:%S')
    local report_data=""
    
    # Collect data
    while IFS=: read -r username _ uid _ _ _ shell; do
        if [[ $uid -ge 1000 ]]; then
            local expiry=$(get_user_expiry "$username")
            if [[ "$expiry" != "never" ]] && [[ -n "$expiry" ]]; then
                local days=$(days_until_expiry "$expiry")
                report_data+="$username|$expiry|$days\n"
            fi
        fi
    done < /etc/passwd
    
    case $format in
        table)
            echo ""
            echo "=== EXPIRY-GUARD COMPLIANCE REPORT ==="
            echo "Generated: $report_date"
            echo "System: $(hostname)"
            echo "======================================"
            echo ""
            printf "%-20s %-18s %12s\n" "USERNAME" "EXPIRY DATE" "DAYS LEFT"
            printf "%-20s %-18s %12s\n" "--------------------" "------------------" "------------"
            echo -e "$report_data" | while IFS='|' read -r username expiry days; do
                [[ -n "$username" ]] && printf "%-20s %-18s %12s\n" "$username" "$expiry" "$days"
            done
            echo ""
            echo "=== END OF REPORT ==="
            ;;
            
        html)
            local html_content="<!DOCTYPE html>
<html lang=\"en\">
<head>
    <meta charset=\"UTF-8\">
    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
    <title>Expiry Guard - Compliance Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 40px; background: #0b0e17; color: #e2e8f0; }
        .container { max-width: 900px; margin: 0 auto; }
        h1 { color: #f59e0b; border-bottom: 2px solid #2a3352; padding-bottom: 10px; }
        .meta { color: #64748b; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background: #131829; color: #f59e0b; padding: 12px; text-align: left; border-bottom: 2px solid #2a3352; }
        td { padding: 12px; border-bottom: 1px solid #2a3352; }
        tr:hover { background: #131829; }
        .urgent { color: #ef4444; font-weight: bold; }
        .warning { color: #f59e0b; }
        .ok { color: #10b981; }
        .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #2a3352; color: #64748b; font-size: 0.9em; }
    </style>
</head>
<body>
    <div class=\"container\">
        <h1>🔐 Expiry Guard - Temporary User Compliance Report</h1>
        <div class=\"meta\">
            <strong>Generated:</strong> $report_date<br>
            <strong>System:</strong> $(hostname)<br>
            <strong>Report ID:</strong> EG-$(date +%s)
        </div>
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Expiry Date</th>
                    <th>Days Remaining</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>"
            
            while IFS=: read -r username _ uid _ _ _ shell; do
                if [[ $uid -ge 1000 ]]; then
                    local expiry=$(get_user_expiry "$username")
                    if [[ "$expiry" != "never" ]] && [[ -n "$expiry" ]]; then
                        local days=$(days_until_expiry "$expiry")
                        local status_class="ok"
                        local status_text="Active"
                        
                        if [[ $days -lt 0 ]]; then
                            status_class="urgent"
                            status_text="EXPIRED"
                        elif [[ $days -le 7 ]]; then
                            status_class="warning"
                            status_text="Expiring Soon"
                        fi
                        
                        html_content+="
                <tr>
                    <td>$username</td>
                    <td>$expiry</td>
                    <td>$days</td>
                    <td class=\"$status_class\">$status_text</td>
                </tr>"
                    fi
                fi
            done < /etc/passwd
            
            html_content+="
            </tbody>
        </table>
        <div class=\"footer\">
            <p>Generated by expiry-guard v${VERSION}</p>
            <p>For compliance inquiries, contact your system administrator.</p>
        </div>
    </div>
</body>
</html>"
            
            if [[ -n "$output_file" ]]; then
                echo "$html_content" > "$output_file"
                log_success "HTML report saved to: $output_file"
            else
                echo "$html_content"
            fi
            ;;
            
        json)
            local json_content="{"
            json_content+="\"generated\": \"$report_date\","
            json_content+="\"system\": \"$(hostname)\","
            json_content+="\"version\": \"${VERSION}\","
            json_content+="\"accounts\": ["
            
            local first=true
            while IFS=: read -r username _ uid _ _ _ shell; do
                if [[ $uid -ge 1000 ]]; then
                    local expiry=$(get_user_expiry "$username")
                    if [[ "$expiry" != "never" ]] && [[ -n "$expiry" ]]; then
                        local days=$(days_until_expiry "$expiry")
                        local status="active"
                        [[ $days -lt 0 ]] && status="expired"
                        [[ $days -le 7 && $days -ge 0 ]] && status="expiring_soon"
                        
                        [[ "$first" == "false" ]] && json_content+=","
                        first=false
                        
                        json_content+="{"
                        json_content+="\"username\": \"$username\","
                        json_content+="\"expiry_date\": \"$expiry\","
                        json_content+="\"days_remaining\": $days,"
                        json_content+="\"status\": \"$status\""
                        json_content+="}"
                    fi
                fi
            done < /etc/passwd
            
            json_content+="]}"
            
            if [[ -n "$output_file" ]]; then
                echo "$json_content" | python3 -m json.tool 2>/dev/null || echo "$json_content" > "$output_file"
                log_success "JSON report saved to: $output_file"
            else
                echo "$json_content" | python3 -m json.tool 2>/dev/null || echo "$json_content"
            fi
            ;;
            
        csv)
            echo "username,expiry_date,days_remaining"
            while IFS=: read -r username _ uid _ _ _ shell; do
                if [[ $uid -ge 1000 ]]; then
                    local expiry=$(get_user_expiry "$username")
                    if [[ "$expiry" != "never" ]] && [[ -n "$expiry" ]]; then
                        local days=$(days_until_expiry "$expiry")
                        echo "$username,$expiry,$days"
                    fi
                fi
            done < /etc/passwd
            ;;
    esac
}

# Main command dispatcher
case "${1:-}" in
    create)
        shift
        cmd_create "$@"
        ;;
    audit)
        shift
        cmd_audit "$@"
        ;;
    alert)
        shift
        cmd_alert "$@"
        ;;
    report)
        shift
        cmd_report "$@"
        ;;
    help|--help|-h)
        show_usage
        ;;
    version|--version|-v)
        echo "expiry-guard version ${VERSION}"
        ;;
    "")
        log_error "No command specified"
        show_usage
        exit 1
        ;;
    *)
        log_error "Unknown command: $1"
        show_usage
        exit 1
        ;;
esac
